{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lula-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // agents/mcp/server uses AsyncLocalStorage
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "lula-mcp-staging"
    }
  }
}
